{
  "name": "pigai",
  "productName": "Pigai",
  "version": "1.0.3",
  "description": "语文学习 AI 助手：作文批改 + 古诗背诵默写（Electron 桌面版）",
  "author": "Martin",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.martin.pigai",
    "productName": "Pigai",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "log.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "录制学生的古诗背诵音频，用于背诵批改与流畅度评估。"
      }
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
